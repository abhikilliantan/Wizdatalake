# =============================================================================
# DataLakeSkM — environment template
# =============================================================================
# cp .env.example .env
# Edit secrets before sharing or deploying beyond local Docker.
# =============================================================================

# --- App / runtime -----------------------------------------------------------
APP_ENV=development
APP_NAME=DataLakeSkM
LOG_LEVEL=INFO
INGESTION_HOST=0.0.0.0
INGESTION_PORT=8000
WEBHOOK_SHARED_SECRET=dev-webhook-secret-change-me
# Optional dedicated key for /v1/serve/* (defaults to WEBHOOK_SHARED_SECRET)
AGENT_ACCESS_SECRET=

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=datalake-raw
MINIO_API_PORT=9006
MINIO_CONSOLE_PORT=9007
MINIO_ENDPOINT_URL=http://localhost:9006
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_MAX_RETRIES=5
MINIO_CONSOLE_URL=http://localhost:9007

# --- PostgreSQL (platform metadata catalog) ----------------------------------
POSTGRES_USER=datalake
POSTGRES_PASSWORD=datalake
POSTGRES_DB=datalake
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://datalake:datalake@localhost:5433/datalake

# --- Redpanda / Kafka (event streaming) --------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_INGEST=datalake.ingest
KAFKA_GROUP_ID=datalake-streaming-consumer
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT_MS=5000
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1

# --- Source connectors -------------------------------------------------------
SALESFORCE_ENABLED=false
SALESFORCE_WEBHOOK_PATH=/v1/ingest/salesforce

HUBSPOT_ENABLED=false
HUBSPOT_WEBHOOK_PATH=/v1/ingest/hubspot

SAP_ENABLED=true
SAP_WEBHOOK_PATH=/v1/ingest/sap

SOURCE_POSTGRES_ENABLED=false
SOURCE_POSTGRES_DSN=

SOURCE_MYSQL_ENABLED=false
SOURCE_MYSQL_DSN=

FILE_INGEST_ENABLED=true
FILE_INGEST_DIR=./data/incoming
